# Copiar este archivo como .env (Docker) o .env.local (XAMPP) y completar los valores.
# No subir nunca los archivos .env con valores reales.

# Servicio PHP/Apache
APP_PORT=8080

# Servicio MySQL
# Docker: MYSQL_HOST=mysql | XAMPP: MYSQL_HOST=127.0.0.1
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=piccolodb
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Correo saliente (SMTP)
MAILER_HOST=
MAILER_PORT=587
MAILER_USERNAME=
MAILER_PASSWORD=
MAILER_ENCRYPTION=tls
MAILER_FROM_ADDRESS=
MAILER_FROM_NAME="Piccolo Burgers"
