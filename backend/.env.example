# Copiar este archivo como .env (Docker) o .env.local (XAMPP) y completar los valores.
# No subir nunca los archivos .env con valores reales.

# Servicio PHP/Apache
APP_PORT=8080

# Servicio MySQL
# Docker: MYSQL_HOST=mysql | XAMPP: MYSQL_HOST=127.0.0.1
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=piccolodb
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# API
# Direcciones desde donde el frontend puede usar la API (separadas por coma), ej: http://localhost:5173
FRONTEND_URL=
# Lax si el frontend comparte dominio con la API; None si está en otro dominio (requiere HTTPS)
SESSION_SAMESITE=Lax
# Página donde el cliente crea una nueva contraseña.
# Vacío = cliente/restablecer.html del frontend (se deduce de FRONTEND_URL o de la dirección del sitio)
RESET_PASSWORD_URL=

# Correo saliente (SMTP)
MAILER_HOST=
MAILER_PORT=587
MAILER_USERNAME=
MAILER_PASSWORD=
MAILER_ENCRYPTION=tls
MAILER_FROM_ADDRESS=
MAILER_FROM_NAME="Piccolo Burgers"
