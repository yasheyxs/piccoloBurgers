# Para servir el sitio con Apache (XAMPP). En Docker lo hace nginx (ver frontend/nginx.conf.template).

# Los estilos y scripts se revisan en cada visita, así nunca se usa una versión vieja después de un cambio
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.svg$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>
